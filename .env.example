# Copy this file to a new file named .env (or just run SETUP-KEY.bat, which does it for you).
# Keep .env OUTSIDE the public_html folder. Never share it, email it, or upload it to a website.
# These are placeholders only. There is no real key in this file.
ELEVENLABS_API_KEY=
# Optional: eleven_multilingual_v2 (default, best Hindi quality), or eleven_flash_v2_5 (faster, cheaper)
ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional: only if your ElevenLabs account uses a regional host, for example api.in.residency.elevenlabs.io
# ELEVENLABS_API_HOST=api.elevenlabs.io
# Optional (production): extra allowed website addresses, comma separated, for example https://jaiswaldentalclinic.com,https://www.jaiswaldentalclinic.com
# NANDI_ALLOWED_ORIGINS=
